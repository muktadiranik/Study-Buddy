# Python server only. Copy to .env and replace the placeholder.
OPENAI_API_KEY=your_openai_api_key_here
# A model available to your account with Structured Outputs support.
OPENAI_MODEL=gpt-4.1-mini
# Optional: a model with image input and Structured Outputs for handwriting OCR.
# Leave blank to use OPENAI_MODEL. Images are sent only after explicit consent in the app.
OPENAI_OCR_MODEL=
# auto uses original detail for verified GPT-5.4 variants, high for other models.
# original costs more image tokens and requires a compatible vision model.
OPENAI_OCR_IMAGE_DETAIL=auto
